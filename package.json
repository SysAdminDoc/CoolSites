{
  "name": "coolsites",
  "version": "2.3.0",
  "description": "Curated static directory of free tools, open source software, AI projects, and hidden gems.",
  "license": "MIT",
  "type": "commonjs",
  "private": false,
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "node scripts/lint-data.js",
    "lint:source": "node scripts/lint-data.js --source-only",
    "generate": "node scripts/generate-assets.js",
    "build": "npm run lint:source && npm run generate && npm run lint",
    "serve": "node scripts/serve.js",
    "package": "node scripts/package-release.js",
    "check:links": "node scripts/check-links.js",
    "review": "node scripts/review-entry.js",
    "update:stars": "node scripts/update-stars.js",
    "update:favicons": "node scripts/generate-favicon-cache.js"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
