{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysadmindoc.github.io/CoolSites/schemas/site.schema.json",
  "title": "CoolSites site entry",
  "type": "object",
  "required": ["name", "url", "description", "category", "openSource", "requiresAuth", "updatedAt", "tags"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "description": { "type": "string", "minLength": 12 },
    "category": { "type": "string", "minLength": 1 },
    "openSource": { "type": "boolean" },
    "requiresAuth": { "type": "boolean" },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "editorsPick": { "type": "boolean" },
    "alternativeTo": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
