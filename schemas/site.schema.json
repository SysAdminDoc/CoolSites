{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysadmindoc.github.io/CoolSites/schemas/site.schema.json",
  "title": "CoolSites site entry",
  "type": "object",
  "required": ["name", "url", "description", "category", "openSource", "requiresAuth", "updatedAt", "tags"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "repository": {
      "type": "string",
      "format": "uri",
      "description": "Where the source lives, when that is somewhere other than the main link. A project gets one entry, so this is how it links both."
    },
    "description": { "type": "string", "minLength": 12 },
    "category": { "type": "string", "minLength": 1 },
    "openSource": { "type": "boolean" },
    "requiresAuth": { "type": "boolean" },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "When the entry's content last changed. 2026-06-25 on most records means the initial bulk import, not a review."
    },
    "lastReviewedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "When a person last opened this site and confirmed the entry still describes it. Required on anything not left over from the import."
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "editorsPick": { "type": "boolean" },
    "alternativeTo": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
