  <body>
    <outline text="AI &amp; ML" title="AI &amp; ML">
      <outline type="link" text="Agno" title="Agno" description="Build AI agents with memory, knowledge and tools. Python framework for production agents, formerly Phidata." htmlUrl="https://www.agno.com"/>
      <outline type="link" text="AnythingLLM" title="AnythingLLM" description="All-in-one AI desktop app. Chat with documents, RAG, multiple model support. Self-hosted knowledge assistant." htmlUrl="https://anythingllm.com"/>
      <outline type="link" text="Arena AI" title="Arena AI" description="Head-to-head LLM comparisons with blind voting. The most credible LLM benchmark based on human preference." htmlUrl="https://arena.ai"/>
      <outline type="link" text="AUTOMATIC1111 WebUI" title="AUTOMATIC1111 WebUI" description="The most popular Stable Diffusion interface. ControlNet, LoRA, inpainting and upscaling, all in one UI." htmlUrl="https://github.com/AUTOMATIC1111/stable-diffusion-webui"/>
      <outline type="link" text="Chatterbox TTS" title="Chatterbox TTS" description="High-quality open source TTS with emotion control and voice cloning from short samples. MIT licensed." htmlUrl="https://github.com/resemble-ai/chatterbox"/>
      <outline type="link" text="Civitai" title="Civitai" description="Community hub for Stable Diffusion models. LoRAs, checkpoints and embeddings. The modding scene for AI art." htmlUrl="https://civitai.com"/>
      <outline type="link" text="ComfyUI" title="ComfyUI" description="Node-based Stable Diffusion GUI. Visual workflow editor for AI image generation pipelines. Infinitely extensible." htmlUrl="https://www.comfy.org"/>
      <outline type="link" text="CrewAI" title="CrewAI" description="Framework for orchestrating AI agents working together. Define roles, goals, and tasks for multi-agent systems." htmlUrl="https://www.crewai.com"/>
      <outline type="link" text="Dify" title="Dify" description="Open source LLM app development platform. RAG, agents, workflow orchestration with a visual canvas." htmlUrl="https://dify.ai"/>
      <outline type="link" text="Flowise" title="Flowise" description="Visual LangChain builder. Drag and drop LLM apps with RAG, agents, and chains. No code needed." htmlUrl="https://flowiseai.com"/>
      <outline type="link" text="GPT4All" title="GPT4All" description="Run LLMs on consumer hardware. Simple installer, offline-capable, privacy-focused. By Nomic AI." htmlUrl="https://www.nomic.ai/gpt4all"/>
      <outline type="link" text="Groq" title="Groq" description="LLM inference at insane speeds on custom LPU chips. Free API tier with blazing-fast Llama and Mixtral." htmlUrl="https://groq.com"/>
      <outline type="link" text="Hugging Face" title="Hugging Face" description="The GitHub of AI. Millions of models, datasets, and spaces. The open source AI community hub." htmlUrl="https://huggingface.co"/>
      <outline type="link" text="InvokeAI" title="InvokeAI" description="Professional creative AI platform. Polished Stable Diffusion interface with canvas, layers, and ControlNet." htmlUrl="https://invoke.ai"/>
      <outline type="link" text="Jan" title="Jan" description="Open source ChatGPT alternative that runs 100% offline. Privacy-first, supports multiple models, clean interface." htmlUrl="https://jan.ai"/>
      <outline type="link" text="Kokoro TTS" title="Kokoro TTS" description="Ultra-lightweight text-to-speech. Runs on a Raspberry Pi at real-time speed. 14 voices, no GPU needed." htmlUrl="https://huggingface.co/hexgrad/Kokoro-82M"/>
      <outline type="link" text="LangFlow" title="LangFlow" description="Visual framework for building multi-agent and RAG applications. React Flow-based editor for AI pipelines." htmlUrl="https://www.langflow.org"/>
      <outline type="link" text="LibreChat" title="LibreChat" description="Self-hosted multi-provider chat UI. Connect OpenAI, Anthropic, Google and local models in one interface." htmlUrl="https://www.librechat.ai"/>
      <outline type="link" text="Llamafile" title="Llamafile" description="Single-file executable LLMs. Download one file and run a chatbot. No Python, no Docker, no dependencies." htmlUrl="https://github.com/mozilla-ai/llamafile"/>
      <outline type="link" text="LM Studio" title="LM Studio" description="Desktop app to discover, download, and run local LLMs. Clean UI, no command line needed, OpenAI-compatible API." htmlUrl="https://lmstudio.ai"/>
      <outline type="link" text="LocalAI" title="LocalAI" description="Self-hosted OpenAI-compatible API. Text, image, audio, video, voice cloning. Drop-in replacement, runs on CPU." htmlUrl="https://localai.io"/>
      <outline type="link" text="NotebookLM" title="NotebookLM" description="Google&apos;s AI research assistant. Upload documents and chat with them. Generates podcast-style audio summaries." htmlUrl="https://notebooklm.google.com"/>
      <outline type="link" text="Ollama" title="Ollama" description="Run large language models locally with one command. Dead simple CLI. Supports Llama, Mistral, Gemma, and dozens more." htmlUrl="https://ollama.com"/>
      <outline type="link" text="Open WebUI" title="Open WebUI" description="Beautiful self-hosted ChatGPT-like interface for local LLMs. Connects to Ollama and adds RAG, web search and voice." htmlUrl="https://openwebui.com"/>
      <outline type="link" text="OpenRouter" title="OpenRouter" description="Unified API for 200+ LLMs. One endpoint to access Claude, GPT, Gemini, Llama, Mistral, and more. Pay-as-you-go." htmlUrl="https://openrouter.ai"/>
      <outline type="link" text="Papers With Code" title="Papers With Code" description="Every ML paper with its code implementation. Benchmarks, leaderboards, and state-of-the-art tracker." htmlUrl="https://paperswithcode.com"/>
      <outline type="link" text="Perplexity" title="Perplexity" description="AI-powered search engine that cites its sources. Combines web search with LLM synthesis. Free tier available." htmlUrl="https://perplexity.ai"/>
      <outline type="link" text="Replicate" title="Replicate" description="Run ML models in the cloud with one line of code. Huge library of open source models on demand." htmlUrl="https://replicate.com"/>
      <outline type="link" text="TensorFlow Playground" title="TensorFlow Playground" description="Tinker with neural networks in your browser. Visualize how layers, neurons, and features affect learning." htmlUrl="https://playground.tensorflow.org"/>
      <outline type="link" text="Together AI" title="Together AI" description="Run and fine-tune open source models. Fast inference API with competitive pricing. Research-friendly." htmlUrl="https://www.together.ai"/>
      <outline type="link" text="Weights &amp; Biases" title="Weights &amp; Biases" description="ML experiment tracking and visualization. Log metrics, compare runs, and share results. Free for individuals." htmlUrl="https://wandb.ai"/>
      <outline type="link" text="Whisper" title="Whisper" description="OpenAI&apos;s speech-to-text model. Runs locally, supports 99 languages, incredibly accurate transcription." htmlUrl="https://github.com/openai/whisper"/>
    </outline>
    <outline text="AI Creative" title="AI Creative">
      <outline type="link" text="Cleanup.pictures" title="Cleanup.pictures" description="AI-powered object removal from photos. Just brush over what you want gone. Magic inpainting." htmlUrl="https://cleanup.pictures"/>
      <outline type="link" text="ElevenLabs" title="ElevenLabs" description="Hyper-realistic AI voice synthesis and cloning. Free tier for personal projects." htmlUrl="https://elevenlabs.io"/>
      <outline type="link" text="Ideogram" title="Ideogram" description="AI image generator that excels at typography and text rendering in images. Free tier available." htmlUrl="https://ideogram.ai"/>
      <outline type="link" text="Khroma" title="Khroma" description="AI color palette generator. Learns your preferences and generates infinite palettes you&apos;ll actually like." htmlUrl="https://www.khroma.co"/>
      <outline type="link" text="Krea.ai" title="Krea.ai" description="Real-time AI image generation. See results update as you type. Canvas mode for editing." htmlUrl="https://www.krea.ai"/>
      <outline type="link" text="Leonardo.ai" title="Leonardo.ai" description="AI creative suite for game assets, concept art, and design. Fine-tuned models, real-time canvas." htmlUrl="https://leonardo.ai"/>
      <outline type="link" text="Luma AI" title="Luma AI" description="3D capture and generation from photos and text. Dream Machine for video generation." htmlUrl="https://lumalabs.ai"/>
      <outline type="link" text="Midjourney" title="Midjourney" description="AI image generation with extraordinary artistic quality. The standard for creative AI imagery." htmlUrl="https://www.midjourney.com"/>
      <outline type="link" text="Pika" title="Pika" description="AI video generation from text or images. Create and edit videos with simple prompts." htmlUrl="https://pika.art"/>
      <outline type="link" text="Pixlr" title="Pixlr" description="AI-powered online photo editor. Background removal, object eraser, batch editing. Free tier." htmlUrl="https://pixlr.com"/>
      <outline type="link" text="Recraft" title="Recraft" description="AI vector and raster image generation with style control. Create icons, illustrations, and 3D renders from text." htmlUrl="https://www.recraft.ai"/>
      <outline type="link" text="Remove.bg" title="Remove.bg" description="Instant background removal from photos using AI. One click, perfect results, free for preview quality." htmlUrl="https://www.remove.bg"/>
      <outline type="link" text="Runway" title="Runway" description="Creative AI toolkit for video. Gen-3 Alpha for video generation, motion brush, green screen, and more." htmlUrl="https://runway.com/"/>
      <outline type="link" text="Suno" title="Suno" description="AI music generation from text prompts. Create full songs with vocals, instruments, and structure. Free tier." htmlUrl="https://suno.com"/>
      <outline type="link" text="Udio" title="Udio" description="AI music creation platform. Generate high-quality tracks in any genre from text descriptions." htmlUrl="https://www.udio.com"/>
    </outline>
    <outline text="Arr Stack" title="Arr Stack">
      <outline type="link" text="Bazarr" title="Bazarr" description="Automated subtitle downloader. Companion app for Sonarr and Radarr that finds and downloads matching subtitles for your media." htmlUrl="https://www.bazarr.media/"/>
      <outline type="link" text="Flaresolverr" title="Flaresolverr" description="Proxy server to bypass Cloudflare protection for Prowlarr and Jackett. Enables *arr apps to access protected indexers." htmlUrl="https://github.com/FlareSolverr/FlareSolverr"/>
      <outline type="link" text="Lidarr" title="Lidarr" description="Automated music collection manager. Monitors for new albums, downloads, tags, and organizes your music library. Sonarr for music." htmlUrl="https://lidarr.audio/"/>
      <outline type="link" text="Prowlarr" title="Prowlarr" description="Indexer manager for the *arr stack. One place to configure all your torrent and Usenet indexers, syncs with Sonarr/Radarr." htmlUrl="https://prowlarr.com/"/>
      <outline type="link" text="Radarr" title="Radarr" description="Automated movie management. Monitors for releases, grabs the best quality, and organizes your movie collection. Sonarr for films." htmlUrl="https://radarr.video/"/>
      <outline type="link" text="Recyclarr" title="Recyclarr" description="Automatically sync TRaSH Guides quality profiles and custom formats to Sonarr and Radarr. Set and forget optimal settings." htmlUrl="https://recyclarr.dev/"/>
      <outline type="link" text="Seerr" title="Seerr" description="Media request management for Plex. Users browse and request films and shows; you approve. Formerly Overseerr." htmlUrl="https://seerr.dev"/>
      <outline type="link" text="Sonarr" title="Sonarr" description="Automated TV show management. Monitors for new episodes, downloads them, renames files, and organizes your media library." htmlUrl="https://sonarr.tv/"/>
      <outline type="link" text="Tautulli" title="Tautulli" description="Plex server monitoring and statistics dashboard. Track who&apos;s watching what, server performance, and viewing history." htmlUrl="https://tautulli.com/"/>
      <outline type="link" text="Unpackerr" title="Unpackerr" description="Extracts downloaded archives for the *arr stack. Watches download folders and automatically unpacks compressed media files." htmlUrl="https://unpackerr.zip/"/>
    </outline>
    <outline text="Automation" title="Automation">
      <outline type="link" text="Activepieces" title="Activepieces" description="Open source no-code automation platform. Clean UI, 100+ integrations, self-hostable Zapier alternative." htmlUrl="https://www.activepieces.com"/>
      <outline type="link" text="Apache Airflow" title="Apache Airflow" description="The industry standard for data pipeline orchestration. Schedule, monitor, and manage complex workflows." htmlUrl="https://airflow.apache.org"/>
      <outline type="link" text="Huginn" title="Huginn" description="Build agents that monitor the web and act on your behalf. The self-hosted IFTTT for power users." htmlUrl="https://github.com/huginn/huginn"/>
      <outline type="link" text="Make (Integromat)" title="Make (Integromat)" description="Visual automation platform. Connect apps and design workflows with a flowchart-style interface. Generous free tier." htmlUrl="https://www.make.com"/>
      <outline type="link" text="n8n" title="n8n" description="Self-hosted workflow automation with 400+ integrations. Visual node editor. The open source Zapier killer." htmlUrl="https://n8n.io"/>
      <outline type="link" text="Node-RED" title="Node-RED" description="Flow-based programming for IoT and automation. Wire together APIs, devices, and services visually." htmlUrl="https://nodered.org"/>
      <outline type="link" text="Pipedream" title="Pipedream" description="Developer-first automation platform. Connect APIs with code steps. Free tier with 100+ connectors." htmlUrl="https://pipedream.com"/>
      <outline type="link" text="Prefect" title="Prefect" description="Modern workflow orchestration. Schedule, monitor, and manage data pipelines. Python-native." htmlUrl="https://www.prefect.io"/>
      <outline type="link" text="Temporal" title="Temporal" description="Durable execution platform. Build reliable workflows that survive failures. Open source core." htmlUrl="https://temporal.io"/>
      <outline type="link" text="Windmill" title="Windmill" description="Open source developer platform for scripts, workflows, and UIs. Turn scripts into production-grade internal tools." htmlUrl="https://www.windmill.dev"/>
    </outline>
    <outline text="CLI Tools" title="CLI Tools">
      <outline type="link" text="atuin" title="atuin" description="Magical shell history. Search, sync, and analyze your command history across machines. Encrypted." htmlUrl="https://atuin.sh"/>
      <outline type="link" text="bat" title="bat" description="A cat clone with wings. Syntax highlighting, line numbers, git integration, and automatic paging." htmlUrl="https://github.com/sharkdp/bat"/>
      <outline type="link" text="chezmoi" title="chezmoi" description="Manage your dotfiles across multiple machines. Templates, secrets, encryption. The dotfile manager." htmlUrl="https://www.chezmoi.io"/>
      <outline type="link" text="delta" title="delta" description="Syntax-highlighting pager for git, diff, and grep. Beautiful side-by-side diffs in your terminal." htmlUrl="https://github.com/dandavison/delta"/>
      <outline type="link" text="dust" title="dust" description="Intuitive disk usage tool. Like du but with a visual bar chart. Instantly see what&apos;s eating your disk." htmlUrl="https://github.com/bootandy/dust"/>
      <outline type="link" text="exa / eza" title="exa / eza" description="Modern replacement for ls. Colors, icons, git integration, tree view. Makes directory listings beautiful." htmlUrl="https://github.com/eza-community/eza"/>
      <outline type="link" text="fd" title="fd" description="Simple, fast alternative to find. Intuitive syntax, colorized output, respects .gitignore." htmlUrl="https://github.com/sharkdp/fd"/>
      <outline type="link" text="fzf" title="fzf" description="Command-line fuzzy finder. Search interactively through any list, whether that&apos;s files, history or processes." htmlUrl="https://github.com/junegunn/fzf"/>
      <outline type="link" text="httpie" title="httpie" description="Human-friendly CLI HTTP client. Colorized output, intuitive syntax, JSON support. Better than curl for APIs." htmlUrl="https://httpie.io"/>
      <outline type="link" text="jq" title="jq" description="Command-line JSON processor. Slice, filter, map, and transform JSON data. Essential for API work." htmlUrl="https://jqlang.org/"/>
      <outline type="link" text="lazydocker" title="lazydocker" description="Terminal UI for Docker. Manage containers, images, volumes, and networks without memorizing commands." htmlUrl="https://github.com/jesseduffield/lazydocker"/>
      <outline type="link" text="lazygit" title="lazygit" description="Terminal UI for git commands. Stage, commit, rebase and cherry-pick from an interactive TUI." htmlUrl="https://github.com/jesseduffield/lazygit"/>
      <outline type="link" text="neovim" title="neovim" description="Vim-based text editor with Lua extensibility. Modern features, LSP support, massive plugin ecosystem." htmlUrl="https://neovim.io"/>
      <outline type="link" text="nushell" title="nushell" description="Modern shell that treats data as structured tables. Pipelines output real data, not text. Mind-bending." htmlUrl="https://www.nushell.sh"/>
      <outline type="link" text="ripgrep" title="ripgrep" description="Line-oriented search tool (like grep but way faster). Respects .gitignore, Unicode-aware, blazing fast." htmlUrl="https://github.com/BurntSushi/ripgrep"/>
      <outline type="link" text="starship" title="starship" description="Minimal, blazing-fast, infinitely customizable prompt for any shell. Written in Rust. Beautiful defaults." htmlUrl="https://starship.rs"/>
      <outline type="link" text="tldr pages" title="tldr pages" description="Simplified, community-driven man pages. Practical examples for every command. Cut the noise." htmlUrl="https://tldr.sh"/>
      <outline type="link" text="tmux" title="tmux" description="Terminal multiplexer. Split panes, multiple windows, session persistence. Essential for remote work." htmlUrl="https://github.com/tmux/tmux"/>
      <outline type="link" text="yq" title="yq" description="Like jq but for YAML, XML, and TOML. Process config files from the command line." htmlUrl="https://github.com/mikefarah/yq"/>
      <outline type="link" text="zoxide" title="zoxide" description="Smarter cd command. Learns your habits and jumps to directories with fuzzy matching." htmlUrl="https://github.com/ajeetdsouza/zoxide"/>
    </outline>
    <outline text="Containers" title="Containers">
      <outline type="link" text="ArgoCD" title="ArgoCD" description="Declarative GitOps CD for Kubernetes. Auto-sync your cluster state with Git repositories." htmlUrl="https://argo-cd.readthedocs.io"/>
      <outline type="link" text="Docker" title="Docker" description="The platform that started the container revolution. Build, ship, and run applications in containers." htmlUrl="https://www.docker.com"/>
      <outline type="link" text="Harbor" title="Harbor" description="Open source container registry. Store, sign, and scan container images. Enterprise features, CNCF graduated." htmlUrl="https://goharbor.io"/>
      <outline type="link" text="Helm" title="Helm" description="The package manager for Kubernetes. Define, install, and upgrade applications with charts." htmlUrl="https://helm.sh"/>
      <outline type="link" text="k3s" title="k3s" description="Lightweight Kubernetes. Perfect for edge, IoT, CI, ARM. Single binary under 100MB." htmlUrl="https://k3s.io"/>
      <outline type="link" text="Kompose" title="Kompose" description="Convert Docker Compose files to Kubernetes manifests. Migrate from Docker to K8s with one command." htmlUrl="https://kompose.io"/>
      <outline type="link" text="Lens" title="Lens" description="The Kubernetes IDE. Manage clusters, workloads, and Helm charts with a beautiful desktop app." htmlUrl="https://lenshq.io"/>
      <outline type="link" text="Podman" title="Podman" description="Daemonless container engine. Drop-in Docker replacement that runs rootless. No daemon required." htmlUrl="https://podman.io"/>
      <outline type="link" text="Rancher" title="Rancher" description="Complete container management platform. Deploy and manage Kubernetes clusters anywhere." htmlUrl="https://www.rancher.com"/>
    </outline>
    <outline text="Creative" title="Creative">
      <outline type="link" text="Audacity" title="Audacity" description="The classic audio editor. Record, edit, mix, and process audio. Simple enough for beginners, powerful enough for pros." htmlUrl="https://www.audacityteam.org"/>
      <outline type="link" text="Blender" title="Blender" description="The free 3D creation suite. Modeling, animation, rendering, VFX and video editing in one app. An entire studio." htmlUrl="https://www.blender.org"/>
      <outline type="link" text="Canva" title="Canva" description="Design presentations, social media posts, posters and logos. Drag-and-drop with a massive template library." htmlUrl="https://www.canva.com"/>
      <outline type="link" text="Coolors" title="Coolors" description="Super fast color palette generator. Press space for new combos. Export to any format. Wildly addictive." htmlUrl="https://coolors.co"/>
      <outline type="link" text="DaVinci Resolve" title="DaVinci Resolve" description="Hollywood-grade video editing, color grading, VFX and audio. The free version is insanely powerful." htmlUrl="https://www.blackmagicdesign.com/products/davinciresolve/"/>
      <outline type="link" text="Excalidraw" title="Excalidraw" description="Virtual whiteboard with a hand-drawn feel. Perfect for diagrams, wireframes, and collaborative sketching." htmlUrl="https://excalidraw.com"/>
      <outline type="link" text="fffuel.co" title="fffuel.co" description="Collection of SVG generators for gradients, patterns, shapes, and backgrounds. Beautiful, customizable assets." htmlUrl="https://fffuel.co"/>
      <outline type="link" text="Figma" title="Figma" description="Collaborative interface design tool. Real-time multiplayer editing, prototyping, and developer handoff. Free tier." htmlUrl="https://www.figma.com"/>
      <outline type="link" text="GIMP" title="GIMP" description="The open source Photoshop. Advanced image editing, retouching, and composition. Endlessly extensible with plugins." htmlUrl="https://www.gimp.org"/>
      <outline type="link" text="Haikei" title="Haikei" description="Generate unique SVG backgrounds and design assets. Waves, blobs, gradients, stacked layers." htmlUrl="https://haikei.app"/>
      <outline type="link" text="Heroicons" title="Heroicons" description="Beautiful hand-crafted SVG icons by Tailwind CSS creators. Free, MIT licensed, ready for React and Vue." htmlUrl="https://heroicons.com"/>
      <outline type="link" text="Inkscape" title="Inkscape" description="Professional vector graphics editor. Create logos, icons, illustrations, and diagrams. SVG-native." htmlUrl="https://inkscape.org"/>
      <outline type="link" text="Kdenlive" title="Kdenlive" description="Professional non-linear video editor. Multi-track, effects, transitions, proxy editing. Cross-platform." htmlUrl="https://kdenlive.org"/>
      <outline type="link" text="Krita" title="Krita" description="Digital painting and 2D animation. Built by artists for artists. Brushes, layers, and animation timeline." htmlUrl="https://krita.org"/>
      <outline type="link" text="Lottiefiles" title="Lottiefiles" description="Lightweight animations for web and mobile. Thousands of free JSON animations. Tiny file sizes." htmlUrl="https://lottiefiles.com"/>
      <outline type="link" text="Lucide" title="Lucide" description="Beautiful and consistent icon set. Fork of Feather Icons with more icons and active development." htmlUrl="https://lucide.dev"/>
      <outline type="link" text="Motion Canvas" title="Motion Canvas" description="Create code-driven animations and videos programmatically. TypeScript-based with a live preview editor. Perfect for explainer and tech videos." htmlUrl="https://motioncanvas.io/"/>
      <outline type="link" text="OBS Studio" title="OBS Studio" description="Open source streaming and recording. The industry standard for live streaming and screen capture." htmlUrl="https://obsproject.com"/>
      <outline type="link" text="Paint.NET" title="Paint.NET" description="Fast, intuitive image editor for Windows. Layers, effects, plugins, and GPU acceleration. Lighter than Photoshop, more powerful than Paint." htmlUrl="https://paint.net/"/>
      <outline type="link" text="Penpot" title="Penpot" description="Open source design and prototyping platform. Figma alternative that&apos;s web-based and self-hostable." htmlUrl="https://penpot.app"/>
      <outline type="link" text="Photopea" title="Photopea" description="Full Photoshop clone that runs entirely in your browser. Supports PSD, XCF, Sketch files. Free." htmlUrl="https://www.photopea.com"/>
      <outline type="link" text="Realtime Colors" title="Realtime Colors" description="Visualize your color palette on a real website layout. See how your colors actually look before committing." htmlUrl="https://www.realtimecolors.com"/>
      <outline type="link" text="Rive" title="Rive" description="Create interactive animations for apps and games. State machines, runtime integration, and real-time collaboration. Free tier available." htmlUrl="https://rive.app/"/>
      <outline type="link" text="Shape Divider" title="Shape Divider" description="Generate custom section dividers for your website. Waves, curves and triangles, exported as SVG or CSS." htmlUrl="https://www.shapedivider.app"/>
      <outline type="link" text="Shots.so" title="Shots.so" description="Create beautiful mockups for your screenshots. Browser frames, device mockups, custom backgrounds." htmlUrl="https://shots.so"/>
      <outline type="link" text="Squoosh" title="Squoosh" description="Google&apos;s image compression tool. Compare codecs side by side, resize and optimize, all in the browser." htmlUrl="https://squoosh.app"/>
      <outline type="link" text="SVG Repo" title="SVG Repo" description="500,000+ free SVG icons and vectors. Searchable, customizable, and categorized." htmlUrl="https://www.svgrepo.com"/>
      <outline type="link" text="TinyPNG" title="TinyPNG" description="Smart lossy compression for PNG and JPEG. Dramatically reduces file size with minimal quality loss." htmlUrl="https://tinypng.com"/>
      <outline type="link" text="unDraw" title="unDraw" description="Free SVG illustrations that you can customize colors on. Huge library of modern, flat-style graphics." htmlUrl="https://undraw.co"/>
      <outline type="link" text="Vectornator (Linearity Curve)" title="Vectornator (Linearity Curve)" description="Free vector design tool with pen, node, and shape tools. Create illustrations, logos, and UI designs with a modern, intuitive interface." htmlUrl="https://www.linearity.io/curve/"/>
    </outline>
    <outline text="DNS Tools" title="DNS Tools">
      <outline type="link" text="dig (web)" title="dig (web)" description="Web-based dig command. Query DNS records from multiple nameservers without touching the CLI." htmlUrl="https://www.digwebinterface.com"/>
      <outline type="link" text="DMARC Analyzer" title="DMARC Analyzer" description="Check your DMARC record configuration. Essential for preventing email spoofing of your domain." htmlUrl="https://mxtoolbox.com/dmarc.aspx"/>
      <outline type="link" text="DNS Leak Test" title="DNS Leak Test" description="Tests whether your VPN is leaking DNS queries. Essential for privacy verification." htmlUrl="https://www.dnsleaktest.com"/>
      <outline type="link" text="DNSChecker" title="DNSChecker" description="Check DNS propagation across 100+ global servers. Supports all record types with map visualization." htmlUrl="https://dnschecker.org"/>
      <outline type="link" text="DNSViz" title="DNSViz" description="Visualizes DNSSEC authentication chains. See exactly where validation breaks down." htmlUrl="https://dnsviz.net"/>
      <outline type="link" text="IntoDNS" title="IntoDNS" description="Full DNS health check for your domain. Reports configuration issues and best practices." htmlUrl="https://intodns.com"/>
      <outline type="link" text="MXToolbox" title="MXToolbox" description="The go-to for email deliverability. Blacklist checks, MX lookups, SPF/DKIM validation." htmlUrl="https://mxtoolbox.com"/>
