      <outline type="link" text="Linear" title="Linear" description="Issue tracking that doesn&apos;t suck. Fast, keyboard-driven, opinionated. Free for small teams." htmlUrl="https://linear.app"/>
      <outline type="link" text="Logseq" title="Logseq" description="Open source outliner and knowledge management. Block-based, bidirectional links, privacy-first." htmlUrl="https://logseq.com"/>
      <outline type="link" text="Mattermost" title="Mattermost" description="Open source Slack alternative. Self-hosted team messaging with integrations, bots, and DevOps workflows." htmlUrl="https://mattermost.com"/>
      <outline type="link" text="NocoDB" title="NocoDB" description="Turn any database into a smart spreadsheet. Open source Airtable alternative with API generation." htmlUrl="https://nocodb.com"/>
      <outline type="link" text="Notion" title="Notion" description="All-in-one workspace. Notes, docs, wikis, databases, kanban boards. The productivity Swiss Army knife." htmlUrl="https://www.notion.so"/>
      <outline type="link" text="Obsidian" title="Obsidian" description="Knowledge base on local markdown files. Graph view, backlinks, plugins. Your second brain, offline-first." htmlUrl="https://obsidian.md"/>
      <outline type="link" text="Overleaf" title="Overleaf" description="Online LaTeX editor with real-time collaboration. The standard for academic papers and technical documents." htmlUrl="https://www.overleaf.com"/>
      <outline type="link" text="Plane" title="Plane" description="Open source project management. Issues, cycles, modules, analytics. Jira and Linear alternative." htmlUrl="https://plane.so"/>
      <outline type="link" text="StackEdit" title="StackEdit" description="In-browser Markdown editor. WYSIWYG, sync with Google Drive and GitHub, LaTeX math support." htmlUrl="https://stackedit.io"/>
      <outline type="link" text="Stirling PDF" title="Stirling PDF" description="Self-hosted PDF toolkit. Merge, split, rotate, compress, OCR and convert. Every PDF operation in one tool." htmlUrl="https://stirlingpdf.io"/>
      <outline type="link" text="tldraw" title="tldraw" description="Infinite canvas drawing tool. A collaborative whiteboard with shapes, arrows and text. Clean and fast." htmlUrl="https://www.tldraw.com"/>
      <outline type="link" text="Trilium Notes" title="Trilium Notes" description="Hierarchical note-taking app with powerful scripting. Relation maps, book notes, task management. Self-hostable." htmlUrl="https://github.com/TriliumNext/Trilium"/>
      <outline type="link" text="Typst" title="Typst" description="Modern LaTeX alternative. Write papers and documents with a clean syntax. Real-time collaboration." htmlUrl="https://typst.app"/>
      <outline type="link" text="Zulip" title="Zulip" description="Chat with threaded conversations. Open source, combines the immediacy of chat with email-style organization." htmlUrl="https://zulip.com"/>
    </outline>
    <outline text="Reading" title="Reading">
      <outline type="link" text="Calibre" title="Calibre" description="The ultimate ebook management tool. Convert between formats, edit metadata, sync to devices, and host your own ebook server." htmlUrl="https://calibre-ebook.com/"/>
      <outline type="link" text="Kavita" title="Kavita" description="Self-hosted digital library for manga, comics, and ebooks. Beautiful reading UI with OPDS support and user management." htmlUrl="https://www.kavitareader.com/"/>
      <outline type="link" text="Komga" title="Komga" description="Free and open source comics and manga server. OPDS feed, web reader, metadata editing, and multi-user support." htmlUrl="https://komga.org/"/>
      <outline type="link" text="Koodo Reader" title="Koodo Reader" description="Cross-platform ebook reader supporting EPUB, PDF, MOBI, and more. Highlights, notes, syncing, and a beautiful reading UI." htmlUrl="https://koodo.960960.xyz/"/>
      <outline type="link" text="Libby" title="Libby" description="Borrow ebooks and audiobooks free from your local library. Beautiful reading experience on any device with your library card." htmlUrl="https://libbyapp.com/"/>
      <outline type="link" text="Mihon" title="Mihon" description="Free and open source manga reader for Android. Tachiyomi successor with extension support for hundreds of manga sources." htmlUrl="https://mihon.app/"/>
      <outline type="link" text="Open Library" title="Open Library" description="Internet Archive&apos;s library catalog with millions of records. Borrow and read ebooks online for free with a library card." htmlUrl="https://openlibrary.org/"/>
      <outline type="link" text="Project Gutenberg" title="Project Gutenberg" description="Over 70,000 free ebooks. Public domain classics in every format. The oldest digital library, running since 1971." htmlUrl="https://www.gutenberg.org/"/>
      <outline type="link" text="Readarr" title="Readarr" description="Ebook and audiobook collection manager. Automated downloading, organization, and metadata management. Part of the *arr stack." htmlUrl="https://readarr.com/"/>
      <outline type="link" text="Standard Ebooks" title="Standard Ebooks" description="Beautifully formatted public domain ebooks. Professional typography, cover art, and metadata. The premium Gutenberg alternative." htmlUrl="https://standardebooks.org/"/>
      <outline type="link" text="Wotaku" title="Wotaku" description="Comprehensive index for anime, manga, and Japanese media. Curated guides, tools, and resource lists for otaku culture." htmlUrl="https://wotaku.wiki/"/>
    </outline>
    <outline text="Security" title="Security">
      <outline type="link" text="BrowserLeaks" title="BrowserLeaks" description="Shows everything your browser reveals about you: canvas fingerprint, WebGL, fonts and WebRTC leaks." htmlUrl="https://browserleaks.com"/>
      <outline type="link" text="Cover Your Tracks (EFF)" title="Cover Your Tracks (EFF)" description="EFF&apos;s tracker testing tool. See how unique your browser fingerprint is and how trackable you are." htmlUrl="https://coveryourtracks.eff.org"/>
      <outline type="link" text="CyberChef" title="CyberChef" description="GCHQ&apos;s data Swiss Army knife. Encode, decode, encrypt, compress and parse by chaining operations visually." htmlUrl="https://gchq.github.io/CyberChef"/>
      <outline type="link" text="DeHashed" title="DeHashed" description="Breach database search engine. Search by email, username, IP, name, phone, or address." htmlUrl="https://dehashed.com"/>
      <outline type="link" text="Fail2ban" title="Fail2ban" description="Intrusion prevention that bans IPs showing malicious signs. Monitors logs and updates firewall rules automatically." htmlUrl="https://github.com/fail2ban/fail2ban"/>
      <outline type="link" text="GRC ShieldsUP!" title="GRC ShieldsUP!" description="Steve Gibson&apos;s classic port scanner. Tests your firewall from the outside. A legend since 2001." htmlUrl="https://www.grc.com/shieldsup"/>
      <outline type="link" text="Hardenize" title="Hardenize" description="Comprehensive security assessment. Tests email, web, DNS, and network security in one sweep." htmlUrl="https://www.hardenize.com"/>
      <outline type="link" text="Have I Been Pwned" title="Have I Been Pwned" description="Troy Hunt&apos;s breach database. Check if your email or password has appeared in data breaches." htmlUrl="https://haveibeenpwned.com"/>
      <outline type="link" text="Immuniweb" title="Immuniweb" description="Free SSL/TLS test with PCI DSS and HIPAA compliance checking. Goes beyond basic cert validation." htmlUrl="https://www.immuniweb.com/ssl/"/>
      <outline type="link" text="JWT.io" title="JWT.io" description="JSON Web Token decoder and debugger. Paste a JWT and instantly see its header, payload, and verify signatures." htmlUrl="https://jwt.io"/>
      <outline type="link" text="Mozilla Observatory" title="Mozilla Observatory" description="Mozilla&apos;s website security scanner. Tests headers, TLS, cookies, and content security policies." htmlUrl="https://developer.mozilla.org/en-US/observatory"/>
      <outline type="link" text="Nuclei" title="Nuclei" description="Fast vulnerability scanner driven by YAML templates. Community-powered with thousands of detection templates for every CVE." htmlUrl="https://projectdiscovery.io/"/>
      <outline type="link" text="OWASP ZAP" title="OWASP ZAP" description="World&apos;s most popular free security tool for finding vulnerabilities in web applications." htmlUrl="https://www.zaproxy.org"/>
      <outline type="link" text="Pentest-Tools" title="Pentest-Tools" description="Online penetration testing toolkit. Subdomain finder, port scanner, CMS detection, and vulnerability scanning." htmlUrl="https://pentest-tools.com"/>
      <outline type="link" text="Qualys SSL Labs" title="Qualys SSL Labs" description="The gold standard for SSL/TLS testing. Deep analysis of certificate chains and configuration." htmlUrl="https://www.ssllabs.com/ssltest/"/>
      <outline type="link" text="Report URI" title="Report URI" description="Collect and analyze CSP, HPKP, and other security header violation reports. Free tier available." htmlUrl="https://report-uri.com"/>
      <outline type="link" text="SecurityHeaders" title="SecurityHeaders" description="Grades your HTTP security headers. Quick way to find missing CSP, HSTS, and other protections." htmlUrl="https://securityheaders.com"/>
      <outline type="link" text="Shodan Monitor" title="Shodan Monitor" description="Keep tabs on your organization&apos;s internet-facing devices. Alerts when new services appear." htmlUrl="https://monitor.shodan.io"/>
      <outline type="link" text="Snyk" title="Snyk" description="Developer security platform. Find and fix vulnerabilities in code, open source dependencies, containers, and infrastructure." htmlUrl="https://snyk.io/"/>
      <outline type="link" text="SSL Checker" title="SSL Checker" description="Quick SSL certificate diagnostic. Shows cert chain, expiration dates, and common configuration problems." htmlUrl="https://www.sslshopper.com/ssl-checker.html"/>
      <outline type="link" text="Sucuri SiteCheck" title="Sucuri SiteCheck" description="Free website malware and security scanner. Checks for blocklisting, injections, and defacements." htmlUrl="https://sitecheck.sucuri.net"/>
      <outline type="link" text="Trivy" title="Trivy" description="Comprehensive security scanner for containers, filesystems, Git repos, and Kubernetes. Find vulnerabilities and misconfigurations." htmlUrl="https://trivy.dev/"/>
      <outline type="link" text="urlscan.io" title="urlscan.io" description="Scans and analyzes websites. See every request, cookie, and connection a page makes. Catches phishing." htmlUrl="https://urlscan.io"/>
      <outline type="link" text="VirusTotal" title="VirusTotal" description="Scan files and URLs with 70+ antivirus engines simultaneously. The definitive malware checker." htmlUrl="https://www.virustotal.com"/>
      <outline type="link" text="Wappalyzer" title="Wappalyzer" description="Identify technologies used on any website. Detect CMS, frameworks, analytics, CDNs, and more. Essential for recon and research." htmlUrl="https://www.wappalyzer.com/"/>
    </outline>
    <outline text="Speed Tests" title="Speed Tests">
      <outline type="link" text="Cloudflare Speed Test" title="Cloudflare Speed Test" description="Comprehensive speed test with jitter, latency, packet loss, and download/upload metrics. Goes way beyond a single number." htmlUrl="https://speed.cloudflare.com"/>
      <outline type="link" text="Fast.com" title="Fast.com" description="Netflix-powered speed test. Zero clutter. Useful for detecting content-based throttling since it tests against Netflix servers." htmlUrl="https://fast.com"/>
      <outline type="link" text="LibreSpeed" title="LibreSpeed" description="Self-hostable speed test. Run your own instance for LAN/WAN testing. Truly private." htmlUrl="https://librespeed.org"/>
      <outline type="link" text="M-Lab NDT" title="M-Lab NDT" description="Google-backed network diagnostic tool. Feeds into open data research on global internet performance." htmlUrl="https://speed.measurementlab.net"/>
      <outline type="link" text="OpenSpeedTest" title="OpenSpeedTest" description="Open source HTML5 speed test. No ads. You can deploy your own server for internal network testing." htmlUrl="https://openspeedtest.com"/>
      <outline type="link" text="Packet Loss Test" title="Packet Loss Test" description="Tests for packet loss between you and the server. Critical for diagnosing VoIP and gaming issues." htmlUrl="https://packetlosstest.com"/>
      <outline type="link" text="Speedof.me" title="Speedof.me" description="HTML5-based speed test with a clean visual graph showing your speed over time. Pure browser-based." htmlUrl="https://speedof.me"/>
      <outline type="link" text="TestMy.net" title="TestMy.net" description="Independent speed test with historical tracking. Compare your results over time and against your ISP&apos;s claims." htmlUrl="https://testmy.net"/>
      <outline type="link" text="Waveform Bufferbloat Test" title="Waveform Bufferbloat Test" description="Tests for bufferbloat, the hidden cause of laggy connections even on fast links. Measures loaded against unloaded latency." htmlUrl="https://www.waveform.com/tools/bufferbloat"/>
      <outline type="link" text="WiFiman" title="WiFiman" description="Ubiquiti&apos;s speed test tool. Clean interface, no ads. Powerful with UniFi gear but works standalone." htmlUrl="https://wifiman.com"/>
    </outline>
    <outline text="Sysadmin" title="Sysadmin">
      <outline type="link" text="AWX" title="AWX" description="Open source version of Ansible Tower. Web interface for Ansible with RBAC, scheduling, and inventories." htmlUrl="https://github.com/ansible/awx"/>
      <outline type="link" text="btop" title="btop" description="Resource monitor with a gorgeous TUI. CPU, memory, disk and network, beautifully rendered in the terminal." htmlUrl="https://github.com/aristocratos/btop"/>
      <outline type="link" text="Checkmk" title="Checkmk" description="IT monitoring that works. Auto-discovery, 2000+ plugins, beautiful dashboards. Free raw edition." htmlUrl="https://checkmk.com"/>
      <outline type="link" text="Cloudflare Radar" title="Cloudflare Radar" description="Real-time internet intelligence. Traffic patterns, outages, routing changes, and attack trends globally." htmlUrl="https://radar.cloudflare.com"/>
      <outline type="link" text="Cockpit" title="Cockpit" description="Web-based Linux server administration. Manage storage, networking, containers, and users through your browser." htmlUrl="https://cockpit-project.org"/>
      <outline type="link" text="CrowdSec" title="CrowdSec" description="Open source collaborative security engine. Detect attacks, share threat intelligence, and protect your infrastructure with the crowd." htmlUrl="https://www.crowdsec.net/"/>
      <outline type="link" text="Dozzle" title="Dozzle" description="Real-time Docker log viewer in the browser. Lightweight, no database, just instant container logs." htmlUrl="https://dozzle.dev"/>
      <outline type="link" text="Glances" title="Glances" description="Cross-platform system monitoring tool. All your metrics in one terminal view. Written in Python." htmlUrl="https://nicolargo.github.io/glances/"/>
      <outline type="link" text="GoAccess" title="GoAccess" description="Real-time web log analyzer. Beautiful terminal and HTML dashboards from your access logs." htmlUrl="https://goaccess.io"/>
      <outline type="link" text="Grafana" title="Grafana" description="The observability platform. Beautiful dashboards for metrics, logs, and traces. Connects to everything." htmlUrl="https://grafana.com"/>
      <outline type="link" text="Graylog" title="Graylog" description="Open source log management platform. Collect, index, and analyze structured and unstructured data from any source." htmlUrl="https://graylog.org/"/>
      <outline type="link" text="Guacamole" title="Guacamole" description="Clientless remote desktop gateway. Access SSH, VNC, and RDP servers through your web browser with no plugins needed." htmlUrl="https://guacamole.apache.org/"/>
      <outline type="link" text="Healthchecks.io" title="Healthchecks.io" description="Cron job monitoring. Get alerted when your scheduled tasks fail to check in. Open source, self-hostable." htmlUrl="https://healthchecks.io"/>
      <outline type="link" text="Loki" title="Loki" description="Log aggregation system by Grafana Labs. Like Prometheus, but for logs. Pairs perfectly with Grafana." htmlUrl="https://grafana.com/oss/loki/"/>
      <outline type="link" text="MeshCentral" title="MeshCentral" description="Full-featured open source remote management. Remote desktop, terminal, file transfer, and device management for any OS." htmlUrl="https://meshcentral.com/"/>
      <outline type="link" text="Mozilla SSL Config" title="Mozilla SSL Config" description="SSL/TLS configuration generator. Best-practice configs for Apache, Nginx, HAProxy, and more." htmlUrl="https://ssl-config.mozilla.org"/>
      <outline type="link" text="Netdata" title="Netdata" description="Real-time infrastructure monitoring. Zero-config, per-second granularity, gorgeous auto-generated dashboards." htmlUrl="https://www.netdata.cloud"/>
      <outline type="link" text="NGINXConfig" title="NGINXConfig" description="DigitalOcean&apos;s NGINX config generator. Answer questions, get a production-ready config file." htmlUrl="https://www.digitalocean.com/community/tools/nginx"/>
      <outline type="link" text="Prometheus" title="Prometheus" description="Monitoring and alerting toolkit. Time-series database with powerful query language. Cloud-native standard." htmlUrl="https://prometheus.io"/>
      <outline type="link" text="Rundeck" title="Rundeck" description="Operations automation platform. Schedule and run jobs across your infrastructure with role-based access and audit logging." htmlUrl="https://www.rundeck.com/"/>
      <outline type="link" text="Semaphore" title="Semaphore" description="Modern UI for Ansible. Schedule playbooks, manage inventories, track task history. Beautiful web interface." htmlUrl="https://semaphoreui.com"/>
      <outline type="link" text="ss64" title="ss64" description="Command line reference for every platform. Bash, PowerShell, CMD, macOS, SQL, and more. The sysadmin&apos;s cheat sheet." htmlUrl="https://ss64.com/"/>
      <outline type="link" text="Teleport" title="Teleport" description="Secure access to SSH, Kubernetes, databases, and web apps. Zero-trust, identity-aware proxy. Open source." htmlUrl="https://goteleport.com"/>
      <outline type="link" text="Terraform" title="Terraform" description="Infrastructure as code. Define cloud resources in declarative config files. The industry standard." htmlUrl="https://developer.hashicorp.com/terraform"/>
      <outline type="link" text="Wazuh" title="Wazuh" description="Open source security platform. SIEM, XDR, threat detection, compliance monitoring. Unified security." htmlUrl="https://wazuh.com"/>
      <outline type="link" text="Webmin" title="Webmin" description="Web-based system administration for Unix. Manage users, disk quotas, services, config files, and more." htmlUrl="https://webmin.com"/>
      <outline type="link" text="Zabbix" title="Zabbix" description="Enterprise-class monitoring solution for servers, networks, applications and cloud. All open source." htmlUrl="https://www.zabbix.com"/>
    </outline>
    <outline text="Torrenting" title="Torrenting">
      <outline type="link" text="BiglyBT" title="BiglyBT" description="Feature-rich open source torrent client with swarm merging, I2P integration, and decentralized chat. Azureus/Vuze successor." htmlUrl="https://www.biglybt.com/"/>
      <outline type="link" text="BitMagnet" title="BitMagnet" description="Self-hosted DHT torrent search engine and crawler. Indexes the DHT network and provides a modern web UI for searching." htmlUrl="https://bitmagnet.io/"/>
      <outline type="link" text="BTDigg" title="BTDigg" description="DHT-based torrent search engine. Indexes the distributed hash table directly, great for finding rare and hard-to-find content." htmlUrl="https://btdig.com/"/>
      <outline type="link" text="cross-seed" title="cross-seed" description="Automatically cross-seed torrents across multiple trackers. Maximizes your ratio by finding matching content you already have." htmlUrl="https://www.cross-seed.org/"/>
      <outline type="link" text="Deluge" title="Deluge" description="Lightweight cross-platform torrent client with a powerful plugin system. Supports web UI and daemon mode for remote management." htmlUrl="https://www.deluge-torrent.org/"/>
      <outline type="link" text="ExT" title="ExT" description="Torrent aggregator that searches across multiple indexes. Clean interface with filtering by category, size, and seeders." htmlUrl="https://ext.to/"/>
      <outline type="link" text="Flood" title="Flood" description="Beautiful web UI for rTorrent, qBittorrent, and Transmission. Modern dark interface with real-time stats and management." htmlUrl="https://flood.js.org/"/>
      <outline type="link" text="Knaben" title="Knaben" description="Torrent meta-search aggregator. Searches multiple torrent indexes simultaneously from one clean, ad-free interface." htmlUrl="https://knaben.org/"/>
      <outline type="link" text="PikaTorrent" title="PikaTorrent" description="Modern cross-platform torrent client with a clean UI. Works on desktop and mobile with a built-in web interface." htmlUrl="https://www.pikatorrent.com/"/>
      <outline type="link" text="qBittorrent" title="qBittorrent" description="Feature-rich open source torrent client with built-in search, RSS, sequential downloading, and IP filtering. The community&apos;s top pick." htmlUrl="https://www.qbittorrent.org/"/>
      <outline type="link" text="Seedr" title="Seedr" description="Cloud-based torrent client. Download torrents in the cloud and stream or direct-download the files. 2GB free tier." htmlUrl="https://www.seedr.cc/"/>
      <outline type="link" text="snowfl" title="snowfl" description="Real-time torrent aggregator with a clean, instant interface. Searches multiple sources and displays results as they come in." htmlUrl="https://snowfl.com/"/>
      <outline type="link" text="Stremio" title="Stremio" description="Media center with a huge addon ecosystem. Supports torrent streaming, content discovery, and Trakt integration out of the box." htmlUrl="https://www.stremio.com/"/>
      <outline type="link" text="TorBox" title="TorBox" description="Freemium cloud torrent service with 10GB free storage. Download and stream torrents remotely without a local client." htmlUrl="https://torbox.app/"/>
      <outline type="link" text="Torrent Parts" title="Torrent Parts" description="Edit and inspect .torrent files directly in the browser. View trackers, file lists, piece sizes, and metadata." htmlUrl="https://torrent.parts/"/>
      <outline type="link" text="Torrents CSV" title="Torrents CSV" description="Self-hostable torrent search engine built on a collaborative CSV database. Lightweight, fast, and completely open source." htmlUrl="https://torrents-csv.com/"/>
      <outline type="link" text="Transmission" title="Transmission" description="Minimal, resource-efficient torrent client loved by Linux and macOS users. Clean interface, zero bloat, just works." htmlUrl="https://transmissionbt.com/"/>
      <outline type="link" text="webtor" title="webtor" description="Stream torrent content directly in your browser. No client install, no sign-up, no limits. Just paste a magnet link." htmlUrl="https://webtor.io/"/>
    </outline>
