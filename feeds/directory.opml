      <outline type="link" text="Huly" title="Huly" description="Open source all-in-one project management. Combines Linear, Jira, Slack, and Notion concepts." htmlUrl="https://huly.io"/>
      <outline type="link" text="Joplin" title="Joplin" description="Open source note-taking with end-to-end encryption. Markdown, sync, web clipper. Evernote alternative." htmlUrl="https://joplinapp.org"/>
