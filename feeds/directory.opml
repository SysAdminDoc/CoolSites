    <outline text="Networking" title="Networking">
      <outline type="link" text="Angry IP Scanner" title="Angry IP Scanner" description="Fast network scanner. Ping IPs, resolve hostnames, detect MAC addresses, scan ports." htmlUrl="https://angryip.org"/>
      <outline type="link" text="FileZilla" title="FileZilla" description="Cross-platform FTP, FTPS, and SFTP client. Drag-and-drop file transfers with queue management." htmlUrl="https://filezilla-project.org"/>
      <outline type="link" text="iperf3" title="iperf3" description="Network bandwidth measurement tool. Test throughput between two endpoints. The standard for LAN testing." htmlUrl="https://iperf.fr"/>
      <outline type="link" text="mRemoteNG" title="mRemoteNG" description="Multi-remote connection manager. SSH, RDP, VNC and Telnet in one tabbed interface." htmlUrl="https://mremoteng.org"/>
      <outline type="link" text="mtr" title="mtr" description="Combines traceroute and ping. Continuous monitoring shows exactly where packets are dropping." htmlUrl="https://github.com/traviscross/mtr"/>
      <outline type="link" text="Netbird" title="Netbird" description="Open source WireGuard-based VPN. Zero-config mesh networking with SSO integration. Tailscale alternative." htmlUrl="https://netbird.io"/>
      <outline type="link" text="NetBox" title="NetBox" description="Open source IPAM and DCIM. Document networks, racks, devices, IP addresses, VLANS, circuits." htmlUrl="https://netboxlabs.com"/>
      <outline type="link" text="nmap" title="nmap" description="Network discovery and security auditing. Port scanning, OS detection, service versioning. The classic." htmlUrl="https://nmap.org"/>
      <outline type="link" text="PuTTY" title="PuTTY" description="The classic SSH and telnet client for Windows. Lightweight, portable, battle-tested for decades." htmlUrl="https://www.putty.org"/>
      <outline type="link" text="Termius" title="Termius" description="Modern SSH client. Cross-platform, sync between devices, SFTP, port forwarding. Free tier." htmlUrl="https://termius.com"/>
      <outline type="link" text="WinSCP" title="WinSCP" description="SFTP, FTP, and SCP client for Windows. File transfer and remote editing with a dual-pane interface." htmlUrl="https://winscp.net"/>
      <outline type="link" text="Wireshark" title="Wireshark" description="The world&apos;s foremost network protocol analyzer. Deep packet inspection for troubleshooting and analysis." htmlUrl="https://www.wireshark.org"/>
      <outline type="link" text="Zenmap" title="Zenmap" description="Official nmap GUI. Visual topology maps, host details, saved scans. Makes nmap accessible." htmlUrl="https://nmap.org/zenmap/"/>
    </outline>
    <outline text="News &amp; Reference" title="News &amp; Reference">
      <outline type="link" text="AlternativeTo" title="AlternativeTo" description="Find alternatives to any software. Community-driven recommendations with platform and license filters." htmlUrl="https://alternativeto.net"/>
      <outline type="link" text="ArchWiki" title="ArchWiki" description="The best Linux documentation on the internet. Useful regardless of which distro you run." htmlUrl="https://wiki.archlinux.org"/>
      <outline type="link" text="CSS-Tricks" title="CSS-Tricks" description="Tips, tricks, and techniques on using CSS. Almanac of every CSS property. Now part of DigitalOcean." htmlUrl="https://css-tricks.com"/>
      <outline type="link" text="daily.dev" title="daily.dev" description="Developer news aggregator. Personalized feed from tech blogs, GitHub trending, and community picks." htmlUrl="https://daily.dev"/>
      <outline type="link" text="Devhints.io" title="Devhints.io" description="Beautiful cheatsheets for developers. Bash, React, Git, Vim and CSS as gorgeous one-page references." htmlUrl="https://devhints.io"/>
      <outline type="link" text="Explain XKCD" title="Explain XKCD" description="Wiki explaining every XKCD comic. Because sometimes the math jokes need a footnote." htmlUrl="https://www.explainxkcd.com"/>
      <outline type="link" text="Free Programming Books" title="Free Programming Books" description="Thousands of free programming books and resources. Every language and framework. Community-maintained." htmlUrl="https://ebookfoundation.github.io/free-programming-books/"/>
      <outline type="link" text="free-for.dev" title="free-for.dev" description="Massive list of free-tier developer services covering SaaS, PaaS and IaaS. Everything with a free option." htmlUrl="https://free-for.dev"/>
      <outline type="link" text="Hackaday" title="Hackaday" description="Hardware hacking and electronics projects. Fresh builds, teardowns, and tutorials daily." htmlUrl="https://hackaday.com"/>
      <outline type="link" text="Hacker News" title="Hacker News" description="Y Combinator&apos;s tech news aggregator. The front page of the startup and hacker world." htmlUrl="https://news.ycombinator.com"/>
      <outline type="link" text="Killed by Google" title="Killed by Google" description="Graveyard of Google products and services. 290+ discontinued projects, with dates and descriptions." htmlUrl="https://killedbygoogle.com"/>
      <outline type="link" text="Lobsters" title="Lobsters" description="Computing-focused link aggregation. Invite-only community means higher signal-to-noise than most." htmlUrl="https://lobste.rs"/>
      <outline type="link" text="Product Hunt" title="Product Hunt" description="Discover new tech products daily. Launches, votes, and reviews. Where new tools get their first users." htmlUrl="https://www.producthunt.com"/>
      <outline type="link" text="public-apis" title="public-apis" description="Massive categorized list of free APIs covering weather, music, sports and finance. If it exists, there&apos;s an API for it." htmlUrl="https://github.com/public-apis/public-apis"/>
      <outline type="link" text="QuickRef.ME" title="QuickRef.ME" description="Quick reference cheatsheets for everything. Programming, tools, and Linux commands in clean format." htmlUrl="https://quickref.me"/>
      <outline type="link" text="Slant" title="Slant" description="Product recommendation community. Compare tools with ranked pros and cons from real users." htmlUrl="https://www.slant.co"/>
      <outline type="link" text="Smashing Magazine" title="Smashing Magazine" description="Professional web design and development articles. In-depth guides, tutorials, and resources." htmlUrl="https://www.smashingmagazine.com"/>
      <outline type="link" text="Stack Overflow" title="Stack Overflow" description="Q&amp;A for programmers. 23 million questions answered. The bedrock of developer knowledge sharing." htmlUrl="https://stackoverflow.com"/>
      <outline type="link" text="The Changelog" title="The Changelog" description="News and podcasts for developers. Open source, software development, and the people behind it." htmlUrl="https://changelog.com"/>
    </outline>
    <outline text="OSINT" title="OSINT">
      <outline type="link" text="AbuseIPDB" title="AbuseIPDB" description="Community-driven IP abuse database. Check and report malicious IPs. Essential for firewall rules." htmlUrl="https://www.abuseipdb.com"/>
      <outline type="link" text="BuiltWith" title="BuiltWith" description="Technology profiler for websites. See what CMS, analytics, CDN, hosting, and frameworks any site uses." htmlUrl="https://builtwith.com"/>
      <outline type="link" text="Censys" title="Censys" description="Internet-wide scan data. Search every public-facing device and certificate on the internet." htmlUrl="https://search.censys.io"/>
      <outline type="link" text="crt.sh" title="crt.sh" description="Certificate transparency log search. Find every SSL cert ever issued for a domain, which also reveals subdomains." htmlUrl="https://crt.sh"/>
      <outline type="link" text="DNSDumpster" title="DNSDumpster" description="Domain research tool. Maps DNS records, finds subdomains, and visualizes a domain&apos;s infrastructure." htmlUrl="https://dnsdumpster.com"/>
      <outline type="link" text="Epieos" title="Epieos" description="Find accounts linked to an email address or phone number across social platforms. Free OSINT tool." htmlUrl="https://epieos.com"/>
      <outline type="link" text="GreyNoise" title="GreyNoise" description="Separates targeted attacks from internet background noise. Identifies mass scanners and benign crawlers." htmlUrl="https://viz.greynoise.io"/>
      <outline type="link" text="Hunter.io" title="Hunter.io" description="Find professional email addresses associated with any domain. Verify deliverability too." htmlUrl="https://hunter.io"/>
      <outline type="link" text="IntelligenceX" title="IntelligenceX" description="Search engine for leaked databases, darknet, WHOIS, and more. Powerful for deep OSINT investigations." htmlUrl="https://intelx.io"/>
      <outline type="link" text="Maltego" title="Maltego" description="Visual link analysis for OSINT investigations. Map relationships between people, companies, domains and IPs. The Community Edition is still free." htmlUrl="https://www.maltego.com/pricing/"/>
      <outline type="link" text="OSINT Framework" title="OSINT Framework" description="Interactive tree of OSINT tools organized by category. The starting point for any investigation." htmlUrl="https://osintframework.com"/>
      <outline type="link" text="PhoneInfoga" title="PhoneInfoga" description="Advanced information gathering tool for phone numbers. Scan international numbers with multiple sources." htmlUrl="https://github.com/sundowndev/phoneinfoga"/>
      <outline type="link" text="PublicWWW" title="PublicWWW" description="Source code search engine. Find websites using specific JavaScript, analytics codes, or HTML snippets." htmlUrl="https://publicwww.com"/>
      <outline type="link" text="Pulsedive" title="Pulsedive" description="Threat intelligence platform. Correlate IPs, domains, and URLs with known threat indicators." htmlUrl="https://pulsedive.com"/>
      <outline type="link" text="Shodan" title="Shodan" description="The search engine for internet-connected devices. Find exposed services, cameras, databases, and more." htmlUrl="https://www.shodan.io"/>
      <outline type="link" text="SpiderFoot" title="SpiderFoot" description="Open source OSINT automation. Scans 200+ data sources to map an entity&apos;s digital footprint." htmlUrl="https://github.com/smicallef/spiderfoot"/>
      <outline type="link" text="TinEye" title="TinEye" description="Reverse image search engine. Find where an image appears online, track modifications, and find higher resolutions." htmlUrl="https://tineye.com"/>
      <outline type="link" text="Wayback Machine" title="Wayback Machine" description="See how any website looked at any point in history. Billions of pages archived since 1996." htmlUrl="https://web.archive.org"/>
      <outline type="link" text="Wigle.net" title="Wigle.net" description="Worldwide map of wireless networks. Database of Wi-Fi and cell towers submitted by wardrivers." htmlUrl="https://wigle.net"/>
    </outline>
    <outline text="Privacy" title="Privacy">
      <outline type="link" text="addy.io" title="addy.io" description="Anonymous email forwarding. Create unlimited aliases to protect your real email from spam and tracking." htmlUrl="https://addy.io"/>
      <outline type="link" text="AdGuard Home" title="AdGuard Home" description="Network-wide ad and tracker blocker. Self-hosted DNS server that filters ads for every device on your network. Pi-hole alternative." htmlUrl="https://adguard.com/en/adguard-home/overview.html"/>
      <outline type="link" text="CalyxOS" title="CalyxOS" description="Privacy-focused Android alternative. De-Googled, includes a built-in VPN. For Pixel phones." htmlUrl="https://calyxos.org"/>
      <outline type="link" text="ClearURLs" title="ClearURLs" description="Browser extension that removes tracking parameters from URLs automatically. Clean links when you copy, share, or click." htmlUrl="https://clearurls.xyz/"/>
      <outline type="link" text="Cryptomator" title="Cryptomator" description="Client-side encryption for your cloud storage. Encrypt files before they leave your device. Works with Dropbox, Drive, and more." htmlUrl="https://cryptomator.org/"/>
      <outline type="link" text="CryptPad" title="CryptPad" description="Encrypted collaborative office suite. Docs, sheets, slides and polls, all zero-knowledge encrypted." htmlUrl="https://cryptpad.org"/>
      <outline type="link" text="GrapheneOS" title="GrapheneOS" description="Hardened Android-based mobile OS focused on privacy and security. Sandboxed Google Play, per-app permissions, and exploit mitigations." htmlUrl="https://grapheneos.org/"/>
      <outline type="link" text="LibRedirect" title="LibRedirect" description="Browser extension that redirects popular sites to privacy-respecting frontends (Invidious, Nitter, etc.)." htmlUrl="https://github.com/libredirect/browser_extension"/>
      <outline type="link" text="Mullvad VPN" title="Mullvad VPN" description="Privacy-focused VPN. No email and no accounts, just a number. Pay with cash or crypto. Audited and trusted." htmlUrl="https://mullvad.net"/>
      <outline type="link" text="Portmaster" title="Portmaster" description="Free application firewall with built-in DNS privacy, tracker blocking, and per-app network controls. Beautiful dashboard." htmlUrl="https://safing.io/portmaster/"/>
      <outline type="link" text="Prism Break" title="Prism Break" description="Directory of privacy-respecting alternatives to proprietary software. Organized by platform and use case." htmlUrl="https://prism-break.org"/>
      <outline type="link" text="Privacy Guides" title="Privacy Guides" description="Community-driven resource for digital privacy. Recommendations for VPNs, browsers, email, and more." htmlUrl="https://www.privacyguides.org"/>
      <outline type="link" text="privacy.sexy" title="privacy.sexy" description="Scripts to harden Windows and macOS privacy settings. Checkbox UI generates ready-to-run scripts." htmlUrl="https://privacy.sexy"/>
      <outline type="link" text="PrivateBin" title="PrivateBin" description="Encrypted pastebin built on zero knowledge, so the server never sees your content. Self-hostable." htmlUrl="https://privatebin.info"/>
      <outline type="link" text="Proton Pass" title="Proton Pass" description="End-to-end encrypted password manager from Proton. Built-in 2FA, email aliases, and dark web monitoring. Free tier with unlimited passwords." htmlUrl="https://proton.me/pass"/>
      <outline type="link" text="ProtonMail" title="ProtonMail" description="Encrypted email, calendar, drive, and VPN. Swiss privacy, open source apps, zero-access encryption." htmlUrl="https://proton.me"/>
      <outline type="link" text="SearXNG" title="SearXNG" description="Privacy-respecting metasearch engine. Aggregates results from 70+ engines without tracking you." htmlUrl="https://searxng.org"/>
      <outline type="link" text="Signal" title="Signal" description="The gold standard for private messaging. End-to-end encrypted, open source, no ads, no tracking." htmlUrl="https://signal.org"/>
      <outline type="link" text="SimpleLogin" title="SimpleLogin" description="Email alias service. Generate unique emails for every service. Open source, self-hostable." htmlUrl="https://simplelogin.io"/>
      <outline type="link" text="Standard Notes" title="Standard Notes" description="End-to-end encrypted notes. 100% open source, extensible with editors and themes. Free sync." htmlUrl="https://standardnotes.com"/>
      <outline type="link" text="Tails" title="Tails" description="Portable Linux OS that routes everything through Tor. Boots from USB, leaves no trace on the host." htmlUrl="https://tails.net"/>
      <outline type="link" text="Tor Project" title="Tor Project" description="Anonymous browsing network. Onion routing prevents anyone from tracing your internet activity." htmlUrl="https://www.torproject.org"/>
      <outline type="link" text="uBlock Origin" title="uBlock Origin" description="The most efficient ad and content blocker. Low CPU and memory usage. Open source, community-maintained." htmlUrl="https://ublockorigin.com"/>
      <outline type="link" text="VeraCrypt" title="VeraCrypt" description="Disk encryption software based on TrueCrypt. Create encrypted volumes, encrypt entire drives, or set up hidden operating systems." htmlUrl="https://veracrypt.io/"/>
      <outline type="link" text="Whonix" title="Whonix" description="Desktop OS designed for advanced security and privacy. Runs inside a VM, all traffic through Tor." htmlUrl="https://www.whonix.org"/>
    </outline>
    <outline text="Productivity" title="Productivity">
      <outline type="link" text="Anytype" title="Anytype" description="Local-first, encrypted alternative to Notion. Offline-capable, peer-to-peer sync. Privacy-respecting." htmlUrl="https://anytype.io"/>
      <outline type="link" text="Appsmith" title="Appsmith" description="Open source low-code platform. Build internal tools with drag-and-drop, connected to any database or API." htmlUrl="https://www.appsmith.com"/>
      <outline type="link" text="Cal.com" title="Cal.com" description="Open source Calendly alternative. Self-hostable scheduling with deep calendar integrations." htmlUrl="https://cal.com"/>
      <outline type="link" text="Docuseal" title="Docuseal" description="Open source document signing platform. Create, fill, and sign documents. DocuSign alternative." htmlUrl="https://www.docuseal.com"/>
      <outline type="link" text="Draw.io" title="Draw.io" description="Full-featured diagramming tool. Flowcharts, network diagrams, UML and wireframes, all in the browser and all free." htmlUrl="https://app.diagrams.net"/>
      <outline type="link" text="Grist" title="Grist" description="Open source spreadsheet-database hybrid. Like Airtable but self-hostable. Formulas, dashboards, APIs." htmlUrl="https://www.getgrist.com"/>
